#!/bin/bash

CACHE="$HOME/.cache/rofi-file-search"

# Rofi passes the selected entry as $1
if [ -n "$1" ]; then
    case "$1" in
        FILE\|*)
            path="${1#FILE|}"
            xdg-open "$path" >/dev/null 2>&1 &
            ;;
    esac

    exit 0
fi

# Initial launch: provide the cached list
[ -f "$CACHE" ] && cat "$CACHE"
